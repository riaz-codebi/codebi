# Preserve your existing local DATABASE_URL for inspection/migrations only.
DATABASE_URL=""
# Restricted Flask role, generated by scripts/setup_app_database.py --apply.
# The web application never falls back to the administrative DATABASE_URL.
APP_DATABASE_URL=""
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY="YOUR_PUBLISHABLE_KEY"
# Must exactly match the address used in your browser and Supabase redirect list.
APP_BASE_URL="http://localhost:5000"

# Set a sending API key for the verified mail.codebisolutions.com domain.
RESEND_API_KEY=
# Optional: a stable random value of at least 32 characters. When absent, the app
# creates an ignored instance/secret.key shared by workers on this machine.
SECRET_KEY=""
GOOGLE_PLACES_API_KEY=""
# Combined search + details attempts per UTC month, per installation.
GOOGLE_PLACES_MONTHLY_LIMIT=500
GOOGLE_PLACES_PER_MINUTE_LIMIT=10
